*/=========================================================/*
Procedure: Loading Data into Silver Layer  (Bronze > Silver)
*/=========================================================/*
Purpose of the script:
 - Creating a procedure Silver.load_Silver
 -Truncating Silver Tables
 -Loading clean Data from Bronze Layer after Data Cleansing
 */========================================================/*


EXEC Silver.load_Silver

CREATE OR ALTER PROCEDURE Silver.load_Silver AS 
   BEGIN
       DECLARE @start_time DATETIME , @end_time DATETIME, @batch_start_time DATETIME, @batch_end_time DATETIME;
    BEGIN TRY
  SET @batch_start_time = GETDATE();
  PRINT '==========================================='
  PRINT       'Loading Silver Tables'
  PRINT '============================================'

  PRINT '=============================================='
  PRINT       'Loading CRM Tables'
  PRINT '=============================================='
  SET @start_time =  GETDATE()
  PRINT '---------------------------------------------'
  PRINT 'Truncating Silver.cust_info'
  PRINT '---------------------------------------------'
       TRUNCATE TABLE Silver.cust_info
  PRINT '----------------------------------------------'
  PRINT 'Loading Data Into Silver.cust_info from Bronze Layer'
  PRINT '-----------------------------------------------'
       INSERT INTO Silver.cust_info(cst_id,cst_key,
                                    cst_first_name,
                                    cst_last_name,cst_gndr
                                    ,cst_maritial_status,cst_create_date)

        SELECT
            cst_id,
            cst_key,
            cst_first_name,
            cst_last_name,
            cst_gndr,
            cst_maritial_status,
            cst_create_date
          FROM Bronze.cust_info

    SET  @end_time =  GETDATE()

     PRINT '>> LOADING DURATION:'  +  CAST(DATEDIFF(second ,@start_time,@end_time) AS NVARCHAR) + 'seconds';
        PRINT '>>-----------------------';

    SET @start_time = GETDATE()
        PRINT '------------------------------------'
        PRINT ' TRUNCATING TABLE Silver.prd_info'
        PRINT '--------------------------------------'
            TRUNCATE TABLE Silver.prd_info
        PRINT '----------------------------------------'
        PRINT ' Loading Data into Silver.prd_info'
        PRINT '-------------------------------------------'
        INSERT INTO Silver.prd_info(prd_id,cat_id
                                    ,prd_key,prd_nm,
                                      prd_cost,prd_line,prd_start_dt
                                      ,prd_end_dt)

        SELECT
            prd_id,
            cat_id,
            prd_key,
            prd_nm,
            prd_cost,
            prd_line,
            prd_start_dt,
            prd_end_dt
        FROM Bronze.prd_info

     SET  @end_time =  GETDATE()

     PRINT '>> LOADING DURATION:'  +  CAST(DATEDIFF(second ,@start_time,@end_time) AS NVARCHAR) + 'seconds';
        PRINT '>>-----------------------';

    SET @start_time = GETDATE()
    PRINT '----------------------------------------'
    PRINT ' TRUNCATING TABLE Silver.Sales_details'
    PRINT '------------------------------------------'
        TRUNCATE TABLE Silver.Sales_details

    PRINT '------------------------------------------'
    PRINT ' Loading Data into Silver.Sales_details'
    PRINT '-------------------------------------------'
        INSERT INTO Silver.Sales_details(row_lables,sum_of_sum_of_sales_price)


        SELECT
            row_lables,
            sum_of_sum_of_sales_price
        FROM Bronze.Sales_details

     SET  @end_time =  GETDATE()

     PRINT '>> LOADING DURATION:'  +  CAST(DATEDIFF(second ,@start_time,@end_time) AS NVARCHAR) + 'seconds';
        PRINT '>>-----------------------';

    PRINT '========================================'
    PRINT ' Loading ERP Tables'
    PRINT '========================================='

   SET @start_time  = GETDATE()
    PRINT '------------------------------------'
    PRINT ' TRUNCATING TABLE Silver.cust_AZ12'
    PRINT '--------------------------------------'
        TRUNCATE TABLE Silver.cust_AZ12
    PRINT '---------------------------------------'
    PRINT 'Loading Data into Slver.cust_AZ12'
    PRINT '----------------------------------------'
        INSERT INTO Silver.cust_AZ12(cid,bdate,gen)


        SELECT
            cid,
            bdate,
            gen
        FROM Bronze.cust_AZ12

     SET  @end_time =  GETDATE()

     PRINT '>> LOADING DURATION:'  +  CAST(DATEDIFF(second ,@start_time,@end_time) AS NVARCHAR) + 'seconds';
        PRINT '>>-----------------------';

    SET @start_time = GETDATE()
    PRINT '------------------------------'
    PRINT 'TRUNCATING TABLE Silver.loc_A101'
    PRINT '--------------------------------'
        TRUNCATE TABLE Silver.loc_A101
    PRINT '----------------------------------'
    PRINT ' Loading Data into Silver.loc_A101'
    PRINT '-----------------------------------'
        INSERT INTO Silver.loc_A101(cid,cntry)

        SELECT
            cid,
            cntry
        FROM Bronze.loc_A101

     SET  @end_time =  GETDATE()

     PRINT '>> LOADING DURATION:'  +  CAST(DATEDIFF(second ,@start_time,@end_time) AS NVARCHAR) + 'seconds';
        PRINT '>>-----------------------';

    SET @start_time = GETDATE()
    PRINT '-----------------------------'
    PRINT 'TRUNCATING Silver.px_cat_G1V2'
    PRINT '------------------------------'
        TRUNCATE TABLE Silver.px_cat_G1V2
    PRINT '-------------------------------'
    PRINT 'Loading Data into Silver.px_cat_G1V2'
    PRINT '---------------------------------'
        INSERT INTO Silver.px_cat_G1V2(id,cat,subcat,maintenance)


        SELECT
            id,
            cat,
            subcat,
            maintenance
        FROM Bronze.px_cat_G1V2

    SET  @end_time =  GETDATE()

     PRINT '>> LOADING DURATION:'  +  CAST(DATEDIFF(second ,@start_time,@end_time) AS NVARCHAR) + 'seconds';
        PRINT '>>-----------------------';

       SET @batch_end_time = GETDATE()
        PRINT '=================================';
        PRINT 'LOADIND SILVER LAYER is completed';
        PRINT ' - Total Duration:' + CAST(DATEDIFF(second ,@start_time,@end_time) AS NVARCHAR) + 'seconds';
        PRINT '==================================';
    END TRY
    BEGIN CATCH 
         PRINT '=====================================';
         PRINT 'ERROR OCCURED DURING LOADING SILVER LAYER'
         PRINT 'Error Message' + ERROR_MESSAGE();
         PRINT 'Error Message' + CAST ( ERROR_NUMBER() AS NVARCHAR);
         PRINT 'Error Message' + CAST (ERROR_STATE() AS NVARCHAR);
         PRINT '========================================='
   END CATCH 
   
   END
